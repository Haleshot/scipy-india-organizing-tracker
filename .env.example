# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------------------
# CocoIndex local state
# ---------------------------------------------------------------------------
COCOINDEX_DB=./cocoindex.db

# ---------------------------------------------------------------------------
# Meeting-note source: "local" (fixtures, no credentials) or "google_drive"
# ---------------------------------------------------------------------------
MEETING_NOTES_SOURCE=local
MEETING_NOTES_DIR=./data/meeting_notes

# Optional. Pin the pipeline to one file in that directory, which is what you
# want when you keep re-downloading the same Doc and Google keeps renaming it.
# Leave empty to read every note file; two exports of the same document is then
# an error rather than a silent duplicate.
MEETING_NOTES_FILE=

# Google Drive (only needed when MEETING_NOTES_SOURCE=google_drive).
# Share the Drive folder with the service account's email first.
# https://cocoindex.io/docs/connectors/google_drive/#setting-up-a-service-account
GOOGLE_SERVICE_ACCOUNT_CREDENTIAL=./secrets/your-service-account-key.json
GOOGLE_DRIVE_ROOT_FOLDER_IDS=

# ---------------------------------------------------------------------------
# Meeting extractor: "markdown" (deterministic, no API key) or "llm"
# ---------------------------------------------------------------------------
MEETING_EXTRACTOR=markdown

# LLM models, LiteLLM provider strings. Only used when MEETING_EXTRACTOR=llm.
LLM_MODEL=openai/gpt-5-mini
RESOLUTION_LLM_MODEL=openai/gpt-5-mini
OPENAI_API_KEY=

# Person entity resolution: "exact" (normalised string match, no models) or
# "embedding" (CocoIndex embedding + LLM pair resolver, needs an API key).
PERSON_RESOLUTION=exact

# ---------------------------------------------------------------------------
# Volunteer applications: "none", "local" (JSON file) or "google_sheet"
#
# "none" while sign-ups are still being reviewed. Nobody who filled in the form
# should appear in the graph until they have been spoken to and have agreed.
# ---------------------------------------------------------------------------
VOLUNTEER_SOURCE=none
VOLUNTEER_APPLICATIONS_FILE=./data/volunteers/applications.json

# Google Sheet (only needed when VOLUNTEER_SOURCE=google_sheet)
VOLUNTEER_SHEET_ID=
VOLUNTEER_SHEET_RANGE=Form Responses 1

# ---------------------------------------------------------------------------
# Workgroup registry
# ---------------------------------------------------------------------------
WORKGROUPS_CONFIG=./config/workgroups.yaml

# ---------------------------------------------------------------------------
# Live mode: how often `cocoindex update -L` re-reads the notes.
# Ignored by a normal catch-up run. Keeps Neo4j fresh and nothing else; use
# ./scripts/refresh.sh --watch to keep the snapshot and search current too.
# ---------------------------------------------------------------------------
LIVE_REFRESH_SECONDS=20

# ---------------------------------------------------------------------------
# Neo4j
# ---------------------------------------------------------------------------
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=scipy-india-cocoindex
NEO4J_DATABASE=neo4j

# ---------------------------------------------------------------------------
# Search (MCP server and `python -m scipy_india_kg.query search`)
# ---------------------------------------------------------------------------
# Full-text search needs nothing here; build it with
#   python scripts/build_search_indexes.py
#
# Setting this turns on vector and hybrid retrieval. A bare HuggingFace repo id
# runs locally with no API key; a LiteLLM "provider/model" string uses that
# provider's credentials. It must match the model the indexes were built with.
SEARCH_EMBEDDING_MODEL=

# --------------------------------------------------------------------------- #
# GitHub issues, the second source. 'none' turns it off.
#
# A public repository needs no token: GitHub allows 60 requests an hour from one
# address, which covers a manual refresh. Set GITHUB_TOKEN to raise that to
# 5000, which anything on a schedule wants, and which a private repo requires.
# --------------------------------------------------------------------------- #
ISSUE_SOURCE=none
GITHUB_REPOS=scipy-india/planning
GITHUB_TOKEN=
GITHUB_ISSUE_STATE=all

# The organising team and their GitHub handles. See config/people.yaml.
PEOPLE_CONFIG=config/people.yaml
