  "decisions": [
    {
      "statement": "IIT Madras works for both days. Malayaja and Srihari walked the lecture halls and the space for tutorials; power and seating are fine, and the open question is catering.",
      "workgroup": "logistics",
      "meetings": [
        4
      ],
      "date": "2026-08-22"
    },
    {
      "statement": "We have more volunteer interest than we can place right now, so we shortlist rather than assigning everyone, and we talk to people before putting them on anything.",
      "workgroup": "registration-help-desk",
      "meetings": [
        4
      ],
      "date": "2026-08-22"
    },
    {
      "statement": "Keynote outreach is a shared job. Everyone brings names and everyone sends emails, so nobody is a bottleneck.",
      "workgroup": "program-committee",
      "meetings": [
        3
      ],
      "date": "2026-08-08"
    },
    {
      "statement": "Talk submissions go through our own pretalx instance rather than a hosted service, so we keep control of the data and the review workflow.",
      "workgroup": "website",
      "meetings": [
        3
      ],
      "date": "2026-08-08"
    },
    {
      "statement": "The budget is the version we take to sponsors. Everyone had input; Malayaja owns keeping it current.",
      "workgroup": "sponsoring",
      "meetings": [
        3
      ],
      "date": "2026-08-08"
    },
    {
      "statement": "We visit IIT Madras before committing to anything, rather than deciding from a floor plan.",
      "workgroup": "logistics",
      "meetings": [
        3
      ],
      "date": "2026-08-08"
    },
    {
      "statement": "The deck goes out only after the budget is in it, so sponsors can see what their money pays for.",
      "workgroup": "sponsoring",
      "meetings": [
        2
      ],
      "date": "2026-07-25"
    },
    {
      "statement": "Three sponsor tiers. The lowest one is free for non-profits and community groups, because we want them in the room rather than priced out.",
      "workgroup": "sponsoring",
      "meetings": [
        2
      ],
      "date": "2026-07-25"
    },
    {
      "statement": "SciPy India 2026 runs on 19 and 20 December, workshops on the first day and the conference on the second.",
      "workgroup": null,
      "meetings": [
        1
      ],
      "date": "2026-07-11"
    },
    {
      "statement": "Volunteer sign-ups go through a form rather than email, so responses land in one place.",
      "workgroup": "registration-help-desk",
      "meetings": [
        1
      ],
      "date": "2026-07-11"
    },
